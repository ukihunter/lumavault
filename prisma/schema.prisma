generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum LibraryType {
  MOVIES
  SERIES
  MIXED
}

enum MediaSourceType {
  FILE
  ARCHIVE
}

model Library {
  id          String      @id @default(cuid())
  name        String
  path        String      @unique
  type        LibraryType

  movies      Movie[]
  series      Series[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Movie {
  id          String   @id @default(cuid())
  title       String
  description String?
  year        Int?

 

  duration    Int?
   // TMDB metadata
  tmdbId      Int?
  overview    String?
  poster      String?
  backdrop    String?
  voteAverage Float?
  libraryId   String
  library     Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  mediaSource MediaSource?
  progress    Progress?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([libraryId])
  @@index([title])
  @@index([year])
}

model Series {
  id          String   @id @default(cuid())
  title       String
  description String?
  

// TMDB metadata
  tmdbId      Int?
  overview    String?
  poster      String?
  backdrop    String?
  voteAverage Float?
  year        Int?
  libraryId   String
  library     Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  seasons     Season[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([libraryId])
  @@index([title])
  @@index([year])
}

model Season {
  id          String    @id @default(cuid())
  number      Int
  title       String?

  seriesId    String
  series      Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  episodes    Episode[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([seriesId, number])
}

model Episode {
  id          String      @id @default(cuid())
  number      Int
  title       String
  description String?

  thumbnail   String?
  duration    Int?

  seasonId    String
  season      Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  progress    Progress?
  mediaSource MediaSource?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([seasonId, number])
}

model MediaSource {
  id          String          @id @default(cuid())
  type        MediaSourceType

  /*
   * FILE source
   *
   * Example:
   * /media/movies/Interstellar.mkv
   */
  filePath    String?         @unique

  /*
   * ARCHIVE source
   *
   * Example:
   * /media/Ben 10/Alien Force.zip
   */
  archivePath String?

  /*
   * Path of the media file inside the archive.
   *
   * Example:
   * Ben 10_ Alien Force (2008)/S03E18.mp4
   */
  entryPath   String?

  movieId     String?         @unique
  movie       Movie?          @relation(fields: [movieId], references: [id], onDelete: Cascade)

  episodeId   String?         @unique
  episode     Episode?        @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([archivePath, entryPath])
  @@index([type])
  @@index([archivePath])
}
 
model Progress {
  id          String   @id @default(cuid())
  position    Int      @default(0)
  completed   Boolean  @default(false)

  episodeId   String?  @unique
  episode     Episode? @relation(fields: [episodeId],references: [id],onDelete: Cascade)

  movieId     String?  @unique
  movie       Movie?   @relation(fields: [movieId],references: [id],onDelete: Cascade)

  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}